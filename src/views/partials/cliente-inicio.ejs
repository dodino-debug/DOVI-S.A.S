<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title><%= locals.titulo ? titulo + ' | ' : '' %>Portal de clientes | DOVI S.A.S.</title>
  <link rel="icon" href="/img/favicon.ico" sizes="48x48">
  <link rel="icon" type="image/png" sizes="32x32" href="/img/favicon-32.png">
  <link rel="icon" type="image/png" sizes="16x16" href="/img/favicon-16.png">
  <link rel="apple-touch-icon" href="/img/apple-touch-icon.png">
  <link rel="stylesheet" href="/css/admin.css">
  <link rel="stylesheet" href="/css/cliente.css">
</head>
<body class="portal-cliente">
  <header class="portal-barra">
    <div class="contenedor portal-barra__interior">
      <a class="portal-marca" href="/cliente/solicitudes">
        <img src="/img/icon-192.png" width="44" height="44" alt="">
        DOVI S.A.S.
      </a>
      <nav aria-label="Portal de clientes">
        <a href="/cliente/solicitudes"<%- locals.seccion === 'solicitudes' ? ' aria-current="page"' : '' %>>Mis solicitudes</a>
        <a href="/cliente/fincas"<%- locals.seccion === 'fincas' ? ' aria-current="page"' : '' %>>Mis fincas</a>
        <a href="/cliente/servicios"<%- locals.seccion === 'servicios' ? ' aria-current="page"' : '' %>>Servicios</a>
        <a href="/cambiar-clave">Cambiar contraseña</a>
        <form method="post" action="/logout">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
          <button class="boton boton--secundario" type="submit">Cerrar sesión</button>
        </form>
      </nav>
    </div>
  </header>

  <main class="contenedor portal">
    <h1>Portal de clientes</h1>
    <p>Hola, <strong><%= usuario.nombre %></strong>.</p>
