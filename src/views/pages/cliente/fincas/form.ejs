<% const editando = Boolean(predio.id); %>
<%- include('../../../partials/cliente-inicio', {
  titulo: editando ? 'Editar predio' : 'Registrar predio',
  seccion: 'fincas'
}) %>

<section class="tarjeta tarjeta--form" aria-labelledby="titulo-form-finca">
  <div class="tarjeta__cabecera">
    <h2 id="titulo-form-finca"><%= editando ? 'Editar predio' : 'Registrar nuevo predio' %></h2>
  </div>

  <form class="formulario" method="POST" novalidate
        action="<%= editando ? '/cliente/fincas/' + predio.id : '/cliente/fincas' %>">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">

    <% if (errores.length) { %>
      <ul class="errores" role="alert">
        <% errores.forEach((error) => { %><li><%= error %></li><% }); %>
      </ul>
    <% } %>

    <label for="nombre">Nombre del predio</label>
    <input id="nombre" name="nombre" type="text" maxlength="100" value="<%= predio.nombre %>" required>

    <label for="ubicacion">Ubicación (vereda, corregimiento o coordenadas)</label>
    <textarea id="ubicacion" name="ubicacion" rows="3" maxlength="255" required><%= predio.ubicacion %></textarea>

    <label for="area">Área en hectáreas</label>
    <input id="area" name="area" type="text" inputmode="decimal" maxlength="11"
           value="<%= predio.area %>" placeholder="Por ejemplo 12.5" required>

    <div class="formulario__acciones">
      <button type="submit" class="boton boton--grande">
        <%= editando ? 'Guardar cambios' : 'Registrar predio' %>
      </button>
      <a class="boton boton--grande boton--secundario" href="/cliente/fincas">Cancelar</a>
    </div>
  </form>
</section>

<%- include('../../../partials/cliente-fin') %>
