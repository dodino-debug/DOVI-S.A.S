<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="csrf-token" content="<%= csrfToken %>">
  <title>Portal de clientes | DOVI S.A.S.</title>
  <link rel="icon" href="/img/favicon.ico">
  <link rel="stylesheet" href="/css/admin.css">
  <link rel="stylesheet" href="/css/admin-extra.css">
  <link rel="stylesheet" href="/css/cliente.css">
</head>
<body class="portal-cliente">
  <header class="portal-barra">
    <div class="contenedor portal-barra__interior">
      <a class="portal-marca" href="/cliente">
        <img src="/img/icon-192.png" width="44" height="44" alt="">
        DOVI S.A.S.
      </a>
      <nav aria-label="Portal de clientes">
        <a href="/cliente"<%- seccion === 'servicios' ? ' aria-current="page"' : '' %>>Servicios</a>
        <a href="/cliente/solicitudes"<%- seccion === 'solicitudes' ? ' aria-current="page"' : '' %>>Mis solicitudes</a>
        <a href="/cambiar-clave">Cambiar contraseña</a>
        <form method="post" action="/logout">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
          <button class="boton boton--secundario" type="submit">Cerrar sesión</button>
        </form>
      </nav>
      <%- include('../../partials/campana') %>
    </div>
  </header>

  <main class="contenedor portal">
    <h1>Portal de clientes</h1>
    <p>Hola, <strong><%= usuario.nombre %></strong>.</p>

    <% if (seccion === 'servicios') { %>
    <section id="servicios" aria-labelledby="titulo-servicios">
      <h2 id="titulo-servicios">Servicios disponibles</h2>
      <% if (!servicios.length) { %>
        <p>En este momento no hay servicios disponibles.</p>
      <% } else { %>
        <ul class="portal-servicios">
          <% servicios.forEach((servicio) => { %>
            <li>
              <h3><%= servicio.nombre %></h3>
              <% if (servicio.descripcion) { %><p><%= servicio.descripcion %></p><% } %>
              <a class="boton" href="/cliente/solicitar?servicio=<%= servicio.id %>" aria-label="Solicitar <%= servicio.nombre %>">Solicitar</a>
            </li>
          <% }); %>
        </ul>
      <% } %>
    </section>

    <% } else if (seccion === 'solicitar') { %>
    <section id="nueva-solicitud" class="tarjeta tarjeta--form" aria-labelledby="titulo-nueva">
      <h2 id="titulo-nueva">Solicitar un servicio</h2>
      <div class="formulario">
        <% if (errores.length) { %>
          <ul class="errores" role="alert">
            <% errores.forEach((error) => { %><li><%= error %></li><% }); %>
          </ul>
        <% } %>
        <% if (!predios.length) { %>
          <p class="formulario__dato">Para solicitar un servicio, contacta a DOVI S.A.S. y pide que registre o active uno de tus predios.</p>
        <% } else if (!servicios.length) { %>
          <p class="formulario__dato">Podrás enviar una solicitud cuando haya un servicio disponible.</p>
        <% } else { %>
          <form method="post" action="/cliente/solicitudes">
            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
            <label for="servicio">Servicio</label>
            <select name="servicio" id="servicio" required>
              <option value="">Selecciona un servicio</option>
              <% servicios.forEach((servicio) => { %>
                <option value="<%= servicio.id %>"<%= Number(formulario.servicio) === servicio.id ? ' selected' : '' %>><%= servicio.nombre %></option>
              <% }); %>
            </select>
            <label for="predio">Predio</label>
            <select name="predio" id="predio" required>
              <option value="">Selecciona un predio</option>
              <% predios.forEach((predio) => { %>
                <option value="<%= predio.id %>"<%= Number(formulario.predio) === predio.id ? ' selected' : '' %>><%= predio.nombre %></option>
              <% }); %>
            </select>
            <label for="fecha">Fecha deseada</label>
            <input type="date" name="fecha" id="fecha" min="<%= fechaMinima %>" value="<%= formulario.fecha %>" required>
            <label for="detalles">Detalles adicionales (opcional)</label>
            <textarea name="detalles" id="detalles" maxlength="255" rows="3"><%= formulario.detalles %></textarea>
            <button class="boton boton--grande" type="submit">Enviar solicitud</button>
          </form>
        <% } %>
      </div>
    </section>

    <% } else if (seccion === 'solicitudes') { %>
    <section id="solicitudes" class="tarjeta" aria-labelledby="titulo-solicitudes">
      <h2 id="titulo-solicitudes">Mis solicitudes</h2>
      <% if (locals.flash) { %>
        <p class="flash flash--<%= flash.tipo %> portal-aviso" role="status"><%= flash.texto %></p>
      <% } %>
      <% if (!solicitudes.length) { %>
        <p class="portal-aviso">Todavía no tienes solicitudes.</p>
      <% } else { %>
        <div class="tabla-scroll">
          <table>
            <thead>
              <tr>
                <th scope="col">Número</th>
                <th scope="col">Servicio</th>
                <th scope="col">Predio</th>
                <th scope="col">Fecha deseada</th>
                <th scope="col">Estado</th>
                <th scope="col">Nota de DOVI</th>
              </tr>
            </thead>
            <tbody>
              <% solicitudes.forEach((solicitud) => { %>
                <tr>
                  <td>#<%= solicitud.id %></td>
                  <td><%= solicitud.servicio %></td>
                  <td><%= solicitud.predio %></td>
                  <td><%= solicitud.fecha_deseada %></td>
                  <td><%= estados[solicitud.estado] || solicitud.estado %></td>
                  <td><%= solicitud.nota_admin || '—' %></td>
                </tr>
              <% }); %>
            </tbody>
          </table>
        </div>
      <% } %>
    </section>
    <% } %>
  </main>
  <script src="/js/notificaciones.js" defer></script>
</body>
</html>
