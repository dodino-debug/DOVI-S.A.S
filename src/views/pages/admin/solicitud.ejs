<%- include('../../partials/admin-inicio', { titulo: 'Solicitud #' + solicitud.id, activo: 'solicitudes' }) %>

<section class="encabezado">
  <h1>Solicitud #<%= solicitud.id %></h1>
  <p><a class="enlace-volver" href="/admin/solicitudes">← Volver a solicitudes</a></p>
</section>

<section class="tarjeta" style="margin-top: 34px;">
  <dl class="detalle">
    <dt>Estado</dt><dd><%= estadoEtiqueta %></dd>
    <dt>Cliente</dt><dd><%= solicitud.cliente %></dd>
    <dt>Predio</dt><dd><%= solicitud.predio %></dd>
    <dt>Ubicación</dt><dd><%= solicitud.ubicacion %></dd>
    <dt>Labor solicitada</dt><dd><%= solicitud.servicio %></dd>
    <dt><%= solicitud.estado === 'REAGENDADA' ? 'Fecha reagendada' : solicitud.estado === 'APROBADA' ? 'Fecha aprobada' : 'Fecha deseada' %></dt><dd><%= solicitud.fecha_deseada %></dd>
    <dt>Detalles</dt><dd class="detalle__texto"><%= solicitud.detalles || 'Sin detalles' %></dd>
    <dt>Registrada</dt><dd><%= solicitud.creada %></dd>
    <% if (solicitud.nota_admin) { %>
      <dt><%= solicitud.estado === 'RECHAZADA' ? 'Motivo del rechazo' : 'Nota administrativa' %></dt>
      <dd class="detalle__texto"><%= solicitud.nota_admin %></dd>
    <% } %>
  </dl>
</section>

<% if (errores.length) { %>
  <ul class="flash flash--error" role="alert">
    <% for (const error of errores) { %><li><%= error %></li><% } %>
  </ul>
<% } %>

<% if (solicitud.estado === 'PENDIENTE') { %>
  <section class="tarjeta formulario">
    <h2>Resolver solicitud</h2>
    <form method="post" action="/admin/solicitudes/<%= solicitud.id %>/aprobar">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <button type="submit" class="boton">Aprobar</button>
    </form>
    <form method="post" action="/admin/solicitudes/<%= solicitud.id %>/reagendar">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <label for="fecha">Nueva fecha</label>
      <input type="date" id="fecha" name="fecha" min="<%= fechaMinima %>" value="<%= formulario.fecha || '' %>" required>
      <button type="submit" class="boton">Reagendar</button>
    </form>
    <form method="post" action="/admin/solicitudes/<%= solicitud.id %>/rechazar">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <label for="motivo">Motivo del rechazo</label>
      <textarea id="motivo" name="motivo" maxlength="255" rows="3" required><%= formulario.motivo || '' %></textarea>
      <button type="submit" class="boton boton--secundario">Rechazar</button>
    </form>
  </section>
<% } %>

<% if (programable) { %>
  <section class="tarjeta">
    <h2>Programar labor</h2>
    <% if (personal.length) { %>
      <form class="formulario" method="post" action="/admin/solicitudes/<%= solicitud.id %>/labores">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <p class="formulario__dato">Ubicación del predio: <%= solicitud.ubicacion %></p>
        <label for="fecha-programada">Fecha</label>
        <input type="date" id="fecha-programada" name="fecha" min="<%= fechaMinima %>"
               value="<%= formulario.fecha || (solicitud.fecha_deseada >= fechaMinima ? solicitud.fecha_deseada : '') %>" required>
        <label for="hora-programada">Hora de Bogotá</label>
        <input type="time" id="hora-programada" name="hora" value="<%= formulario.hora || '' %>" required>
        <fieldset class="formulario__dato">
          <legend>Empleados asignados</legend>
          <% for (const persona of personal) { %>
            <label class="formulario__check">
              <input type="checkbox" name="empleados" value="<%= persona.id %>"<%= formulario.empleados?.includes(persona.id) ? ' checked' : '' %>>
              <%= persona.nombre %> (<%= persona.correo %>)
            </label>
          <% } %>
        </fieldset>
        <button type="submit" class="boton">Programar y asignar</button>
      </form>
    <% } else { %>
      <p class="tarjeta__nota">Activa al menos una cuenta de empleado desde <a href="/admin/usuarios">Usuarios</a> para asignar la labor.</p>
    <% } %>
  </section>
<% } %>

<% if (labores.length) { %>
  <section class="tarjeta">
    <h2>Labores programadas</h2>
    <div class="formulario">
      <ul>
        <% for (const labor of labores) { %>
          <li>#<%= labor.id %> · <%= labor.fecha %> a las <%= labor.hora %> · <%= estadosLabor[labor.estado] %>
            <br>Personal asignado: <%= labor.personal.join(', ') || 'Sin asignar' %>
            <% if (labor.observaciones) { %>
              <br>Observación: <span class="detalle__texto"><%= labor.observaciones %></span>
            <% } %>
          </li>
        <% } %>
      </ul>
    </div>
  </section>
<% } %>

<% if (historial.length) { %>
  <section class="tarjeta formulario">
    <h2>Historial de decisiones</h2>
    <ul>
      <% for (const evento of historial) { %>
        <li>
          <%= evento.registrada %> · <%= evento.accion === 'REAGENDADA' ? 'Reagendada' : evento.accion === 'APROBADA' ? 'Aprobada' : 'Rechazada' %>
          <% if (evento.accion === 'REAGENDADA') { %>
            (<%= evento.fecha_anterior %> → <%= evento.fecha_nueva %>)
          <% } %>
        </li>
      <% } %>
    </ul>
  </section>
<% } %>

<%- include('../../partials/admin-fin') %>
