<%- include('../../../partials/admin-inicio', { titulo: 'Labores', activo: 'labores' }) %>

<section class="encabezado encabezado--accion">
  <div>
    <h1>Órdenes de Trabajo</h1>
    <p>Labores programadas y su avance</p>
  </div>
  <a class="boton boton--grande" href="/admin/labores/nueva">+ Programar Labor</a>
</section>

<form class="filtros" method="GET" action="/admin/labores">
  <label>Estado
    <select name="estado">
      <option value="">Todos</option>
      <% Object.keys(ui.ESTADO_LABOR).forEach(function (e) { %>
        <option value="<%= e %>"<%- filtros.estado === e ? ' selected' : '' %>><%= ui.ESTADO_LABOR[e] %></option>
      <% }) %>
    </select>
  </label>
  <label>Desde <input type="date" name="desde" value="<%= filtros.desde %>"></label>
  <label>Hasta <input type="date" name="hasta" value="<%= filtros.hasta %>"></label>
  <button type="submit" class="boton boton--secundario">Filtrar</button>
  <% if (filtros.estado || filtros.desde || filtros.hasta) { %>
    <a class="boton boton--secundario" href="/admin/labores">Limpiar</a>
  <% } %>
</form>

<% if (error) { %><p class="flash flash--error" role="alert" style="margin-top: 20px;"><%= error %></p><% } %>

<section class="tarjeta">
  <div class="tabla-scroll">
    <table style="min-width: 1040px;">
      <colgroup>
        <col style="width: 6%"><col style="width: 11%"><col style="width: 7%"><col style="width: 14%">
        <col style="width: 14%"><col style="width: 16%"><col style="width: 17%"><col style="width: 9%"><col style="width: 6%">
      </colgroup>
      <thead>
        <tr><th>ID</th><th>Fecha</th><th>Hora</th><th>Cliente</th><th>Predio</th><th>Labor</th><th>Cuadrilla</th><th>Estado</th><th></th></tr>
      </thead>
      <tbody>
        <% if (labores.length === 0) { %>
          <tr><td class="vacio" colspan="9">No hay labores con ese filtro.</td></tr>
        <% } else { labores.forEach(function (l) { %>
          <tr>
            <td class="id">#<%= l.id %></td>
            <td><%= l.fecha %></td>
            <td><%= l.hora %></td>
            <td class="cliente"><%= l.cliente %></td>
            <td><%= l.predio %></td>
            <td><%= l.servicio %></td>
            <td><%= l.cuadrilla %></td>
            <td><span class="insignia <%= ui.CLASE_ESTADO[l.estado] %>"><%= ui.ESTADO_LABOR[l.estado] %></span></td>
            <td><a class="boton" href="/admin/labores/<%= l.id %>">Ver</a></td>
          </tr>
        <% }); } %>
      </tbody>
    </table>
  </div>
  <div class="tarjeta__nota">
    <span>Se muestran las 200 labores más recientes que cumplen el filtro.</span>
  </div>
</section>

<%- include('../../../partials/admin-fin') %>
