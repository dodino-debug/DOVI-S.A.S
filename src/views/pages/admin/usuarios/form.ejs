<% var editando = !!cuenta.id; %>
<%- include('../../../partials/admin-inicio', {
  titulo: editando ? 'Editar usuario' : 'Nuevo usuario',
  activo: 'usuarios'
}) %>

<section class="encabezado">
  <h1><%= editando ? 'Editar Usuario' : 'Nuevo Usuario' %></h1>
  <p><a class="enlace-volver" href="/admin/usuarios">← Volver a usuarios</a></p>
</section>

<section class="tarjeta tarjeta--form" style="margin-top: 34px;">
  <form class="formulario" method="POST" novalidate
        action="<%= editando ? '/admin/usuarios/' + cuenta.id : '/admin/usuarios' %>">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">

    <% if (errores.length) { %>
      <ul class="errores" role="alert">
        <% errores.forEach(function (e) { %><li><%= e %></li><% }) %>
      </ul>
    <% } %>

    <% if (editando) { %>
      <p class="formulario__dato"><strong>Rol:</strong> <%= etiquetaRol[cuenta.rol] %> (no se puede cambiar)</p>
    <% } else { %>
      <label for="rol">Rol</label>
      <select id="rol" name="rol">
        <% rolesCreables.forEach(function (r) { %>
          <option value="<%= r %>"<%- cuenta.rol === r ? ' selected' : '' %>><%= etiquetaRol[r] %></option>
        <% }) %>
      </select>
    <% } %>

    <label for="nombre">Nombre completo</label>
    <input id="nombre" name="nombre" type="text" maxlength="120" value="<%= cuenta.nombre %>" required>

    <label for="correo">Correo electrónico</label>
    <input id="correo" name="correo" type="email" maxlength="160" value="<%= cuenta.correo %>"
           autocomplete="off" required>

    <label for="telefono">Teléfono (opcional)</label>
    <input id="telefono" name="telefono" type="tel" maxlength="30" value="<%= cuenta.telefono %>">

    <div data-bloque-supervisor<%- cuenta.rol === 'empleado' ? '' : ' hidden' %>>
      <label for="supervisor_id">Supervisor</label>
      <select id="supervisor_id" name="supervisor_id">
        <option value="">Sin supervisor</option>
        <% supervisores.forEach(function (s) { %>
          <option value="<%= s.id %>"<%- Number(cuenta.supervisor_id) === s.id ? ' selected' : '' %>>
            <%= s.nombre %><%= s.activo ? '' : ' (inactivo)' %>
          </option>
        <% }) %>
      </select>
    </div>

    <% if (!editando) { %>
      <p class="formulario__ayuda">
        El sistema genera una contraseña temporal. La verás una sola vez al guardar y el usuario
        deberá cambiarla en su primer ingreso.
      </p>
    <% } %>

    <div class="formulario__acciones">
      <button type="submit" class="boton boton--grande"><%= editando ? 'Guardar' : 'Crear usuario' %></button>
      <a class="boton boton--grande boton--secundario" href="/admin/usuarios">Cancelar</a>
    </div>
  </form>
</section>

<%- include('../../../partials/admin-fin', { scripts: ['/js/usuario-form.js'] }) %>