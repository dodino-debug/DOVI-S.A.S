<% var editando = !!cliente.id; %>
<%- include('../../../partials/admin-inicio', {
  titulo: editando ? 'Editar cliente' : 'Nuevo cliente',
  activo: 'clientes'
}) %>

<section class="encabezado">
  <h1><%= editando ? 'Editar Cliente' : 'Nuevo Cliente' %></h1>
  <p>
    <a class="enlace-volver" href="<%= editando ? '/admin/clientes/' + cliente.id : '/admin/clientes' %>">
      ← Volver
    </a>
  </p>
</section>

<section class="tarjeta tarjeta--form tarjeta--espaciada">
  <form class="formulario" method="POST" novalidate
        action="<%= editando ? '/admin/clientes/' + cliente.id : '/admin/clientes' %>">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">

    <% if (errores.length) { %>
      <ul class="errores" role="alert">
        <% errores.forEach(function (e) { %><li><%= e %></li><% }) %>
      </ul>
    <% } %>

    <label for="nombre">Nombre completo o razón social</label>
    <input id="nombre" name="nombre" type="text" maxlength="150" value="<%= cliente.nombre %>" required>

    <label for="correo">Correo electrónico (con él ingresa a la plataforma)</label>
    <input id="correo" name="correo" type="email" maxlength="100" value="<%= cliente.correo %>"
           autocomplete="off" required>

    <label for="telefono">Teléfono (solo números, con + opcional)</label>
    <input id="telefono" name="telefono" type="tel" maxlength="20" value="<%= cliente.telefono %>"
           inputmode="tel" required>

    <p class="formulario__ayuda">
      <% if (editando) { %>
        Si cambias el correo, el cliente deberá usar el nuevo para ingresar.
      <% } else { %>
        Se crea el acceso del cliente con una contraseña temporal que verás una sola vez al guardar.
        El cliente deberá cambiarla en su primer ingreso.
      <% } %>
    </p>

    <div class="formulario__acciones">
      <button type="submit" class="boton boton--grande"><%= editando ? 'Guardar' : 'Crear cliente' %></button>
      <a class="boton boton--grande boton--secundario"
         href="<%= editando ? '/admin/clientes/' + cliente.id : '/admin/clientes' %>">Cancelar</a>
    </div>
  </form>
</section>

<%- include('../../../partials/admin-fin') %>
