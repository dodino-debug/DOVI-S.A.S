DATABASE_URL=
SESSION_SECRET=
NODE_ENV=development
PORT=3000

# URL pública base (opcional en desarrollo; recomendada en producción para enlaces de recuperación)
APP_URL=

# Correo SMTP opcional (en desarrollo sin SMTP_HOST, el enlace de recuperación se imprime en consola)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=no-reply@dovi.com

# Variables usadas por los scripts de carga inicial (npm run seed:*)
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_TELEFONO=
PRUEBAS_PASSWORD=
